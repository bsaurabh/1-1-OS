    "bcryptjs": "^2.4.3",
    "formidable": "^3.5.1",
    "jose": "^5.4.0",
    "mammoth": "^1.8.0",
    "next": "^14.2.0",
    "openai": "^4.52.0",
    "pdf-parse": "^1.1.1",
    "postcss": "^8.4.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "resend": "^3.3.0",
    "tailwindcss": "^3.4.0",
    "web-push": "^3.6.7"
